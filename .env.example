# ---------- LLM ----------
LLM_PROVIDER=gemini              # gemini | ollama
LLM_FALLBACK_PROVIDER=ollama     # used when the primary fails (none = no fallback)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4

# ---------- Pinecone ----------
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# ---------- Retrieval ----------
EMBEDDING_BACKEND=fastembed      # hashing = offline tests only
HYBRID_ALPHA=0.6                 # 1 = dense only, 0 = BM25 only
TOP_K=6
RERANK_ENABLED=true

# ---------- RLM ----------
RLM_BATCH_SIZE=3
RLM_MAX_DEPTH=2
RLM_MAX_CHARS_PER_CALL=2000      # smaller -> more recursion (good for the demo)

# ---------- LangSmith (mandatory for the assessment) ----------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Security ----------
JWT_SECRET=please-change-this-to-a-long-random-string-32chars
RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_PER_SEC=0.2

# ---------- Services ----------
API_URL=http://localhost:8000
MCP_SERVER_URL=http://localhost:8001/mcp
TOOL_TIMEOUT_SECONDS=15
